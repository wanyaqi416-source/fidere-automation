# Deployed Fidere client test environment. Required by client tests.
CLIENT_BASE_URL=

# Required for client login automation. Do not commit real credentials.
CLIENT_USERNAME=
CLIENT_PASSWORD=
CLIENT_OTP=
CLIENT_SECURITY_KEY=

# User-to-user transfer. Sender is always CLIENT_USERNAME; no automatic fallback.
U2U_RECIPIENT_EMAIL=
U2U_RECIPIENT_USE_CLIENT_CREDENTIALS=false
U2U_RUN_ID=
U2U_SOURCE_ACCOUNT_TYPE=
U2U_CURRENCY=
U2U_TEST_AMOUNT=

# Fresh Personal User Registration. The local pool is ignored by git and must
# contain reviewed Sandbox-only email/phone pairs. Never use customer data.
CLIENT_REGISTER_OTP=
PERSONAL_REGISTRATION_EMAIL=
PERSONAL_REGISTRATION_DATA_POOL_PATH=test-data/personal-registration-pool.local.json
PERSONAL_REGISTRATION_PROFILE_PATH=test-data/personal-registration-profile.local.json
PERSONAL_REGISTRATION_ADDRESS_PROOF_PATH=test-assets/personal-registration/address-proof_SANDBOX.png
PERSONAL_REGISTRATION_SEQUENCE_PATH=test-data/registration-sequence.json
PERSONAL_REGISTRATION_GENERATED_EMAIL_DOMAIN=sandbox.fidere.test
PERSONAL_REGISTRATION_GENERATED_PHONE_PREFIX=15590
REGISTRATION_APPROVAL_SOURCE_RUN_ID=
PERSONAL_REGISTRATION_APPROVAL_SOURCE_RUN_ID=
BUSINESS_REGISTRATION_APPROVAL_SOURCE_RUN_ID=
REGISTRATION_KYC_ACCOUNT_TYPE=
CORPORATE_REGISTRATION_EMAIL=
CORPORATE_REGISTRATION_PHONE=
CORPORATE_REGISTRATION_COMPANY_NAME=
CORPORATE_REGISTRATION_PROFILE_PATH=test-data/corporate-registration-profile.local.json
REGISTRATION_SIGNATURE_TEXT=TEST
REGISTRATION_TEST_TITLE=TEST

# Dedicated Sandbox user for jurisdiction account-opening tests.
OPENING_TEST_EMAIL=
OPENING_SIGNER_NAME=TEST
OPENING_SIGNATURE_TEXT=TEST
OPENING_INITIALS=T

# Deployed Fidere admin test environment.
ADMIN_BASE_URL=

# Local standalone Admin flows automatically renew expired auth before tests.
# CI and safe regression suites never open interactive login. Set false to disable.
ADMIN_AUTH_AUTO_RENEW=true

# Required for admin login automation. Do not commit real credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_OTP=

# Optional runtime tuning. Values are milliseconds.
TEST_TIMEOUT_MS=
EXPECT_TIMEOUT_MS=
ACTION_TIMEOUT_MS=
NAVIGATION_TIMEOUT_MS=
ALLOW_CLIENT_MUTATION_TESTS=

# Exchange money tests are disabled by default. Enable only for one approved mutation run.
ALLOW_MONEY_TESTS=false
ALLOW_ADMIN_MUTATION_TESTS=false

# Fresh User Golden Journey. Mutation switches remain false in this file.
JOURNEY_INITIAL_USD_BALANCE=2000
JOURNEY_BUDGET_SAFETY_MARGIN=250
JOURNEY_WITHDRAWAL_FEE_BUDGET=
JOURNEY_BAHRAIN_OPENING_FEE_BUDGET=100
JOURNEY_US_OPENING_FEE_BUDGET=500

# Exchange test data. Use account-type and currency labels from the deployed test UI.
EXCHANGE_SOURCE_ACCOUNT_TYPE=
EXCHANGE_TARGET_ACCOUNT_TYPE=
EXCHANGE_FROM_CURRENCY=
EXCHANGE_TO_CURRENCY=
EXCHANGE_TEST_AMOUNT=

# Existing completed Exchange record used only by the read-only reconciliation test.
# Use page-local timestamps in YYYY-MM-DDTHH:mm:ss format. Never store the OTC ID here.
EXCHANGE_RECONCILIATION_RECEIVED_AMOUNT=
EXCHANGE_RECONCILIATION_EXECUTED_FROM=
EXCHANGE_RECONCILIATION_EXECUTED_TO=

# Client + Admin brokerage transfer validation data. Use labels verified in the real UI.
TRANSFER_BROKER_ACCOUNT_ID=
TRANSFER_BROKER_NAME=
